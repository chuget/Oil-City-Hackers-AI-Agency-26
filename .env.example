# Optional: live Postgres for contract data (same as Streamlit).
# If both are unset, the dashboard uses data/contracts.csv.
DB_CONNECTION_STRING=
# Alternative name (e.g. Next.js / Vercel / Heroku often use this):
DATABASE_URL=

# Postgres TLS for psycopg: prefer | require | disable | allow | verify-full
# Default in code is "prefer" (works for many local DBs). Use "require" for strict TLS.
PGSSLMODE=prefer
