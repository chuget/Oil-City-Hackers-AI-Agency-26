# Agency 2026 unified Postgres warehouse (~23M rows: CRA, FED, AB, general).
# Get connection details from the hackathon Discord / GovAlta repo — do not commit real URLs.
# ProcureIntel queries SQL aggregates only; it never loads full tables into memory.
DB_CONNECTION_STRING=
# Alternative name (e.g. Next.js / Vercel / Render often use this):
DATABASE_URL=

# Postgres TLS for psycopg: prefer | require | disable | allow | verify-full
# Default in code is "prefer" (works for many local DBs). Use "require" for strict TLS.
PGSSLMODE=prefer

# Optional: Groq API key enables the in-dashboard "Ask ProcureIntel" chatbot.
# Get one for free at https://console.groq.com. Without this key, the chat
# button is hidden and the rest of the dashboard works as before.
GROQ_API_KEY=
# Override the default model if you want (defaults to llama-3.1-8b-instant).
GROQ_MODEL=llama-3.1-8b-instant

# If Groq HTTPS fails with SSL: CERTIFICATE_VERIFY_FAILED (common on macOS Python):
# 1) pip install -r requirements.txt  (includes certifi; the app uses it for Groq)
# 2) Or point to a PEM bundle: SSL_CERT_FILE=/path/to/cacert.pem
# Last resort only (insecure): GROQ_SSL_VERIFY=0
